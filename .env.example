JASPER_MODEL=qwen3:14b
JASPER_FAST_MODEL=qwen3:8b
OLLAMA_HOST=http://127.0.0.1:11434
JASPER_KEEP_ALIVE=5m
JASPER_THINK=false
LOG_LEVEL=INFO
MAX_HISTORY_MESSAGES=20

# Long-term memory
JASPER_MEMORY_ENABLED=true
JASPER_MEMORY_SEARCH_LIMIT=5

# Voice
JASPER_VOICE_ENABLED=false
JASPER_STT_MODEL=small
JASPER_STT_DEVICE=auto
JASPER_STT_GPU_COMPUTE_TYPE=int8_float16
JASPER_STT_CPU_COMPUTE_TYPE=int8
# Use "auto" for English/Bahasa Malaysia/rojak. "bm", "malay", and "bahasa melayu" map to Whisper's "ms".
JASPER_STT_LANGUAGE=auto
JASPER_STT_BEAM_SIZE=5
# Optional domain/language hint. Leave blank unless a repeated vocabulary helps recognition.
JASPER_STT_INITIAL_PROMPT=
JASPER_TTS_PROVIDER=windows
# Optional Windows voice name; blank uses the system default voice.
JASPER_TTS_VOICE=
JASPER_TTS_RATE=0
JASPER_TTS_VOLUME=100
JASPER_PIPER_MODEL=data/voices/en_US-lessac-medium.onnx
JASPER_PIPER_CONFIG=data/voices/en_US-lessac-medium.onnx.json
JASPER_PIPER_USE_CUDA=false
JASPER_VOICE_SAMPLE_RATE=16000
JASPER_VOICE_RECORD_MAX_SECONDS=8
JASPER_VOICE_MIN_SECONDS=0.6
JASPER_VOICE_SILENCE_SECONDS=0.9
JASPER_VOICE_SILENCE_THRESHOLD=0.01
# Continuous conversation is bounded; it is not always-listening and has no wake word.
JASPER_VOICE_CONVERSATION_MAX_TURNS=8
JASPER_VOICE_CONVERSATION_EMPTY_LIMIT=2
